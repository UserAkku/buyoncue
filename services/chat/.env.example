# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Send /whoami to the bot to find it
# (the bot boots without it, but only /start and /whoami work until it is set).
TELEGRAM_OWNER_USER_ID=

# --- Engine (separate service; the ONLY authority for spending) --------------
ENGINE_URL=http://localhost:3001
# Shared secret sent as "Authorization: Bearer <token>" on every /v1/* call.
INTERNAL_API_TOKEN=

# --- GitHub webhook ----------------------------------------------------------
# Same secret you enter in GitHub -> Settings -> Webhooks -> Secret.
GITHUB_WEBHOOK_SECRET=

# --- LLM (optional, any OpenAI-compatible chat API) --------------------------
# Leave all three empty to use the guided /newrule flow (no AI).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- HTTP server (GitHub webhook + /healthz) ----------------------------------
PORT=3002
