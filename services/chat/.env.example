# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Send /whoami to the bot to find it
# (the bot boots without it, but only /start and /whoami work until it is set).
TELEGRAM_OWNER_USER_ID=

# --- Engine (separate service; the ONLY authority for spending) --------------
ENGINE_URL=http://localhost:3001
# Shared secret sent as "Authorization: Bearer <token>" on every /v1/* call.
INTERNAL_API_TOKEN=

# --- GitHub webhook ----------------------------------------------------------
# Same secret you enter in GitHub -> Settings -> Webhooks -> Secret.
GITHUB_WEBHOOK_SECRET=

# --- LLM (optional, any OpenAI-compatible chat API) --------------------------
# Leave all three empty to use the guided /newrule flow (no AI).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- HTTP server (GitHub webhook + /healthz) ----------------------------------
PORT=3002

# --- GitHub App (AI bounties). Leave ALL of these empty to keep the feature off. ---
# See docs/GITHUB_APP_SETUP.md. If you set any, you must set every one of them.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM from "Generate a private key". Raw PEM, a single line with \n escapes, or base64 of the PEM.
GITHUB_APP_PRIVATE_KEY=
# Must equal PUBLIC_CHAT_URL + /auth/github/callback and be listed as the app's Callback URL.
GITHUB_OAUTH_CALLBACK_URL=
# https://github.com/apps/<your-app-slug>/installations/new
GITHUB_APP_INSTALL_URL=
# Public HTTPS base URL of this service (your tunnel or deployment), no trailing slash.
PUBLIC_CHAT_URL=

# Optional: where link/session state (no secrets) is kept. Default: .data/chat-state.json
# CHAT_STATE_FILE=

# Optional Bedrock Converse provider; separate credentials in each service.
LLM_PROVIDER=
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_CHAT_MODEL_ID=
BEDROCK_MAX_OUTPUT_TOKENS=2048
BEDROCK_MAX_INPUT_CHARS=120000

# Local PEM path; omit GITHUB_APP_PRIVATE_KEY when using a path.
GITHUB_APP_PRIVATE_KEY_PATH=
