DATABASE_URL=postgresql://pactpilot:password@localhost:5432/pactpilot
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
BITREFILL_API_KEY=
BITREFILL_BASE_URL=https://api.bitrefill.com/v2
PUBLIC_ENGINE_URL=http://localhost:3001
LIVE_PURCHASES_ENABLED=false
# Required in live mode: positive private chat ID verified through the bot. Leave unset during setup.
# AUTHORIZED_RECIPIENT_CHAT_ID=123456789
PORT=3001
# Required for encrypted redemption outbox, including test mode. Generate: openssl rand -hex 32
REDEMPTION_ENCRYPTION_KEY=
APPROVAL_TTL_SECONDS=900
WORKER_INTERVAL_MS=2000
# Runtime inference credentials (separate from Codex/Claude subscriptions; engine only).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
AI_REVIEW_MIN_CONFIDENCE=0.8
AI_REVIEW_MAX_AGE_SECONDS=3600
# Sending private source to an inference provider requires explicit owner consent.
AI_ALLOW_PRIVATE_REPOSITORIES=false

# Optional Bedrock Converse provider; separate credentials in each service.
LLM_PROVIDER=
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REVIEW_MODEL_ID=
BEDROCK_MAX_OUTPUT_TOKENS=2048
BEDROCK_MAX_INPUT_CHARS=120000
LLM_REVIEW_MAX_CALLS_PER_PR=6
